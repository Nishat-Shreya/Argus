<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.DashboardController"
            styleClass="dashboard-root">
    <left>
        <fx:include fx:id="sidebar" source="sidebar-nav.fxml"/>
    </left>
    <center>
        <BorderPane>
            <top>
                <VBox>
                    <HBox styleClass="topbar-shell" alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="2">
                            <Label fx:id="operatorNameLabel" styleClass="topbar-operator-name"
                                   text="Welcome back"/>
                            <Label text="Monitor. Detect. Stay ahead." styleClass="topbar-operator-role"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Circle radius="4" styleClass="topbar-status-dot"/>
                            <Label text="system online" styleClass="topbar-status-online"/>
                        </HBox>
                    </HBox>
                    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED"
                                vbarPolicy="NEVER" styleClass="toolbar-scroll">
                        <HBox fx:id="toolbar" styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="targetField" promptText="target domain" styleClass="field"/>
                            <Button fx:id="scanButton" text="scan" styleClass="primary-button"
                                    onAction="#onScan" defaultButton="true"/>
                            <Button fx:id="pauseButton" text="pause" styleClass="secondary-button"
                                    onAction="#onPauseResume" disable="true"/>
                            <Button fx:id="cancelButton" text="cancel" styleClass="danger-button"
                                    onAction="#onCancel" disable="true"/>
                            <Label fx:id="messageLabel" styleClass="form-error" visible="false"
                                   managed="false" wrapText="true"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Circle fx:id="liveDot" radius="5" styleClass="live-dot"/>
                        </HBox>
                    </ScrollPane>
                </VBox>
            </top>
            <center>
                <ScrollPane fitToWidth="true" styleClass="dashboard-scroll">
                    <VBox spacing="20">
                        <padding>
                            <Insets top="20" right="24" bottom="24" left="24"/>
                        </padding>

                        <HBox spacing="16">
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                                <Label fx:id="totalScansValue" styleClass="metric-card-value" text="0"/>
                                <Label text="Total Scans" styleClass="metric-card-label"/>
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                                <Label fx:id="totalFindingsValue" styleClass="metric-card-value" text="0"/>
                                <Label text="Total Findings" styleClass="metric-card-label"/>
                            </VBox>
                            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                                <Label fx:id="scheduledScansValue" styleClass="metric-card-value" text="0"/>
                                <Label text="Scheduled Scans" styleClass="metric-card-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="16">
                            <VBox styleClass="section-card" HBox.hgrow="ALWAYS" spacing="10">
                                <Label text="Findings by Type" styleClass="section-card-title"/>
                                <PieChart fx:id="findingsByTypeChart" legendVisible="true" prefHeight="240"/>
                            </VBox>
                            <VBox styleClass="section-card" HBox.hgrow="ALWAYS" spacing="10">
                                <Label text="Scan Trend (7 days)" styleClass="section-card-title"/>
                                <LineChart fx:id="scanTrendChart" legendVisible="false" animated="false"
                                           prefHeight="240">
                                    <xAxis>
                                        <CategoryAxis side="BOTTOM"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis side="LEFT"/>
                                    </yAxis>
                                </LineChart>
                            </VBox>
                        </HBox>

                        <VBox styleClass="section-card" spacing="10">
                            <Label text="Recent Scans" styleClass="section-card-title"/>
                            <TableView fx:id="recentScansTable" styleClass="findings-table" prefHeight="200">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="recentTargetColumn" text="target" prefWidth="220"/>
                                    <TableColumn fx:id="recentStatusColumn" text="status" prefWidth="120"/>
                                    <TableColumn fx:id="recentFindingsColumn" text="findings" prefWidth="90"/>
                                    <TableColumn fx:id="recentStartedColumn" text="started" prefWidth="160"/>
                                </columns>
                                <placeholder>
                                    <Label text="no scans yet — run your first scan below"/>
                                </placeholder>
                            </TableView>
                        </VBox>

                        <HBox spacing="12">
                            <Button text="New Scan" styleClass="primary-button" onAction="#onQuickNewScan"/>
                            <Button text="View Findings" styleClass="secondary-button"
                                    onAction="#onQuickViewFindings"/>
                            <Button text="Manage Tags" styleClass="secondary-button"
                                    onAction="#onQuickManageTags"/>
                            <Button text="Create Schedule" styleClass="secondary-button"
                                    onAction="#onQuickCreateSchedule"/>
                        </HBox>

                        <Label text="Live Scan" styleClass="card-title"/>

                        <HBox spacing="16" prefHeight="460">
                            <VBox fx:id="queueDropZone" styleClass="target-queue-panel drop-zone"
                                  prefWidth="240" spacing="8">
                                <Label text="target queue" styleClass="card-title"/>
                                <Label text="drop domains or a text file here" styleClass="form-hint"
                                       wrapText="true"/>
                                <ListView fx:id="queueList" styleClass="target-queue-list"
                                          VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <Label text="queue is empty"/>
                                    </placeholder>
                                </ListView>
                                <HBox spacing="8">
                                    <Button fx:id="runQueueButton" text="run queue" styleClass="primary-button"
                                            onAction="#onRunQueue" disable="true"/>
                                    <Button fx:id="removeQueuedButton" text="remove"
                                            styleClass="secondary-button" onAction="#onRemoveQueued"
                                            disable="true"/>
                                </HBox>
                                <Label fx:id="queueStatusLabel" styleClass="queue-status" wrapText="true"/>
                            </VBox>
                            <SplitPane dividerPositions="0.6" HBox.hgrow="ALWAYS">
                                <TableView fx:id="findingsTable" styleClass="findings-table">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn text="type" prefWidth="90"/>
                                        <TableColumn text="subject" prefWidth="220"/>
                                        <TableColumn text="port" prefWidth="70"/>
                                        <TableColumn text="state" prefWidth="90"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="no findings yet — enter a target and press scan"/>
                                    </placeholder>
                                </TableView>
                                <VBox spacing="0">
                                    <ListView fx:id="workerList" styleClass="worker-list" VBox.vgrow="ALWAYS"/>
                                    <ListView fx:id="logConsole" styleClass="log-console" VBox.vgrow="ALWAYS"/>
                                </VBox>
                            </SplitPane>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </center>
            <bottom>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets top="8" right="16" bottom="8" left="16"/>
                    </padding>
                    <ProgressBar fx:id="progressBar" styleClass="scan-progress" progress="0.0"/>
                    <Label fx:id="statusLine" styleClass="status-line" text="idle"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
