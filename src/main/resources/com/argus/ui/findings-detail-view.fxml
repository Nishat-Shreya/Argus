<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.FindingsDetailController"
            styleClass="findings-detail-root">
    <top>
        <VBox fx:id="root" styleClass="toolbar" spacing="10">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <Label text="findings detail" styleClass="card-title"/>
                <VBox spacing="4">
                    <Label text="scan" styleClass="card-subtitle"/>
                    <HBox spacing="8">
                        <DatePicker fx:id="datePicker"/>
                        <ComboBox fx:id="scanCombo" prefWidth="220"/>
                    </HBox>
                </VBox>
                <Button fx:id="loadButton" text="load" styleClass="primary-button"
                        onAction="#onLoad"/>
                <Button fx:id="backButton" text="back to dashboard" styleClass="secondary-button"
                        onAction="#onBack"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-error" visible="false" managed="false"
                   wrapText="true"/>
            <Label fx:id="hiddenLabel" styleClass="form-hint" wrapText="true"/>
            <Label fx:id="unsourceableLabel" styleClass="form-hint" wrapText="true"
                   text="threat-intel and KEV results are not persisted with a scan yet — this panel shows what the scan recorded."/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.45">
            <TableView fx:id="findingsTable" styleClass="findings-table">
                <columns>
                    <TableColumn text="type" prefWidth="90"/>
                    <TableColumn text="subject" prefWidth="220"/>
                    <TableColumn text="port" prefWidth="70"/>
                    <TableColumn text="state" prefWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="no findings yet — choose a scan and press load"/>
                </placeholder>
            </TableView>
            <VBox fx:id="detailPane" styleClass="detail-pane" spacing="10" visible="false"
                  managed="false">
                <VBox fx:id="detailLinesBox" spacing="4"/>
                <Label fx:id="noteCountLabel" styleClass="card-subtitle"/>
                <ListView fx:id="notesList" styleClass="note-list" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="no notes on this finding yet"/>
                    </placeholder>
                </ListView>
                <TextArea fx:id="noteField" styleClass="note-field" promptText="add a note…"
                          wrapText="true" prefHeight="34" minHeight="-Infinity"
                          maxHeight="-Infinity"/>
                <HBox spacing="8">
                    <Button fx:id="addNoteButton" text="add note" styleClass="primary-button"
                            onAction="#onAddNote"/>
                    <Button fx:id="deleteNoteButton" text="delete note" styleClass="danger-button"
                            onAction="#onDeleteNote" disable="true"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
