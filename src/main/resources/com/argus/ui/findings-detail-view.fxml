<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.FindingsDetailController"
            styleClass="findings-detail-root">
    <top>
        <VBox fx:id="root" styleClass="toolbar" spacing="10">
            <Label text="findings detail" styleClass="card-title"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="scan" styleClass="card-subtitle"/>
                    <HBox spacing="8">
                        <DatePicker fx:id="datePicker"/>
                        <ComboBox fx:id="scanCombo" prefWidth="220"/>
                    </HBox>
                </VBox>
                <Button fx:id="loadButton" text="load" styleClass="primary-button"
                        onAction="#onLoad"/>
                <Button fx:id="backButton" text="back to dashboard" styleClass="secondary-button"
                        onAction="#onBack"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-error" visible="false" managed="false"
                   wrapText="true"/>
            <Label fx:id="hiddenLabel" styleClass="form-hint" wrapText="true"/>
            <Label fx:id="unsourceableLabel" styleClass="form-hint" wrapText="true"
                   text="threat-intel and KEV results are not persisted with a scan yet — this panel shows what the scan recorded."/>
        </VBox>
    </top>
    <center>
        <SplitPane fx:id="detailSplit" dividerPositions="0.45">
            <VBox styleClass="findings-list-pane" spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="filter by tag" styleClass="card-subtitle"/>
                    <ComboBox fx:id="tagFilterCombo" styleClass="tag-filter" prefWidth="160"/>
                </HBox>
                <TableView fx:id="findingsTable" styleClass="findings-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn text="type" prefWidth="90"/>
                        <TableColumn text="subject" prefWidth="220"/>
                        <TableColumn text="port" prefWidth="70"/>
                        <TableColumn text="state" prefWidth="90"/>
                    </columns>
                    <placeholder>
                        <Label text="no findings yet — choose a scan and press load"/>
                    </placeholder>
                </TableView>
            </VBox>
            <VBox fx:id="detailPane" styleClass="detail-pane" spacing="10" visible="false"
                  managed="false">
                <VBox fx:id="detailLinesBox" spacing="4"/>
                <Label fx:id="tagCountLabel" styleClass="card-subtitle"/>
                <ListView fx:id="tagList" styleClass="tag-list">
                    <placeholder>
                        <Label text="no tags on this finding yet"/>
                    </placeholder>
                </ListView>
                <HBox spacing="8">
                    <TextField fx:id="tagField" styleClass="tag-field" promptText="add a tag…"/>
                    <Button fx:id="addTagButton" text="add tag" styleClass="primary-button"
                            onAction="#onAddTag"/>
                    <Button fx:id="removeTagButton" text="remove tag" styleClass="danger-button"
                            onAction="#onRemoveTag" disable="true"/>
                </HBox>
                <Label fx:id="noteCountLabel" styleClass="card-subtitle"/>
                <ListView fx:id="notesList" styleClass="note-list" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="no notes on this finding yet"/>
                    </placeholder>
                </ListView>
                <TextArea fx:id="noteField" styleClass="note-field" promptText="add a note…"
                          wrapText="true" prefHeight="34" minHeight="-Infinity"
                          maxHeight="-Infinity"/>
                <HBox spacing="8">
                    <Button fx:id="addNoteButton" text="add note" styleClass="primary-button"
                            onAction="#onAddNote"/>
                    <Button fx:id="deleteNoteButton" text="delete note" styleClass="danger-button"
                            onAction="#onDeleteNote" disable="true"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
