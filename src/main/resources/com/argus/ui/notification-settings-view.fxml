<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.NotificationSettingsController"
            styleClass="notification-settings-root">
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
            <Label text="notifications" styleClass="card-title"/>
            <Button fx:id="backButton" text="back to dashboard" styleClass="secondary-button"
                    onAction="#onBack"/>
        </HBox>
    </top>
    <center>
        <VBox fx:id="card" styleClass="key-editor" spacing="10">
            <Label styleClass="card-subtitle" wrapText="true"
                   text="paste a webhook URL to receive a JSON POST whenever a scan finds new subdomains, hosts or ports — this sends discovered findings off this machine to the URL you configure"/>
            <Label fx:id="statusLabel" styleClass="form-hint"/>
            <PasswordField fx:id="urlField" promptText="https://hooks.example.com/…"
                            styleClass="field"/>
            <HBox spacing="10">
                <Button fx:id="saveButton" text="save" styleClass="primary-button"
                        onAction="#onSave"/>
                <Button fx:id="removeButton" text="remove" styleClass="danger-button"
                        onAction="#onRemove" disable="true"/>
            </HBox>
            <Label styleClass="card-subtitle" wrapText="true"
                   text="or configure email alerts over SMTPS (implicit TLS, e.g. port 465) — enter host|port|username|to|password"/>
            <Label fx:id="emailStatusLabel" styleClass="form-hint"/>
            <PasswordField fx:id="emailField"
                            promptText="smtp.example.com|465|user@example.com|to@example.com|password"
                            styleClass="field"/>
            <HBox spacing="10">
                <Button fx:id="emailSaveButton" text="save" styleClass="primary-button"
                        onAction="#onSaveEmail"/>
                <Button fx:id="emailRemoveButton" text="remove" styleClass="danger-button"
                        onAction="#onRemoveEmail" disable="true"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-hint" visible="false" managed="false"
                   wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
