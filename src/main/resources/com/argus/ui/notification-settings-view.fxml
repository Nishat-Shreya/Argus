<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.NotificationSettingsController"
            styleClass="notification-settings-root">
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
            <Label text="notifications" styleClass="card-title"/>
            <Button fx:id="backButton" text="back to dashboard" styleClass="secondary-button"
                    onAction="#onBack"/>
        </HBox>
    </top>
    <center>
        <VBox fx:id="card" styleClass="notification-card" spacing="6" maxHeight="-Infinity"
              BorderPane.alignment="TOP_LEFT">
            <BorderPane.margin>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="email alerts" styleClass="card-subtitle"/>
                <Label fx:id="emailStatusLabel" styleClass="form-hint"/>
            </HBox>
            <Label styleClass="form-hint" wrapText="true"
                   text="sent after every completed scan over SMTPS (implicit TLS, e.g. port 465) — enter host|port|username|to|password"/>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <PasswordField fx:id="emailField" HBox.hgrow="ALWAYS"
                               promptText="smtp.example.com|465|user@example.com|to@example.com|password"
                               styleClass="field"/>
                <Button fx:id="emailSaveButton" text="save" styleClass="primary-button"
                        onAction="#onSaveEmail"/>
                <Button fx:id="emailRemoveButton" text="remove" styleClass="danger-button"
                        onAction="#onRemoveEmail" disable="true"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-hint" visible="false" managed="false"
                   wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
