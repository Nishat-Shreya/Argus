<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.ReportController"
            styleClass="report-root">
    <top>
        <VBox fx:id="root" styleClass="toolbar" spacing="10">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="report export" styleClass="card-title"/>
                    <Label styleClass="card-subtitle" wrapText="true"
                           text="exports one completed scan's findings as a standalone HTML or PDF document — not a diff"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="scan" styleClass="card-subtitle"/>
                    <HBox spacing="8">
                        <DatePicker fx:id="scanDatePicker"/>
                        <ComboBox fx:id="scanCombo" prefWidth="220"/>
                    </HBox>
                </VBox>
                <Button fx:id="previewButton" text="preview" styleClass="primary-button"
                        onAction="#onPreview"/>
                <Button fx:id="exportButton" text="export html" styleClass="secondary-button"
                        onAction="#onExport" disable="true"/>
                <Button fx:id="exportPdfButton" text="export pdf" styleClass="secondary-button"
                        onAction="#onExportPdf" disable="true"/>
                <Button fx:id="backButton" text="back to dashboard" styleClass="secondary-button"
                        onAction="#onBack"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-error" visible="false" managed="false"
                   wrapText="true"/>
            <Label fx:id="hiddenLabel" styleClass="form-hint"/>
            <Label fx:id="previewNoteLabel" styleClass="report-note" wrapText="true"
                   text="preview shows the report's content; the exported file is a standalone HTML document"/>
            <Label fx:id="exportHintLabel" styleClass="report-note" wrapText="true"
                   text="both formats are written unencrypted to the location you choose"/>
        </VBox>
    </top>
    <center>
        <VBox styleClass="report-preview" spacing="8">
            <padding>
                <Insets top="12" right="16" bottom="0" left="16"/>
            </padding>
            <Label fx:id="targetLabel" styleClass="card-subtitle"/>
            <Label fx:id="timestampLabel" styleClass="status-line"/>
            <Label fx:id="summaryLabel" styleClass="status-line"/>
            <TableView fx:id="findingsTable" styleClass="report-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="type" prefWidth="90"/>
                    <TableColumn text="subject" prefWidth="220"/>
                    <TableColumn text="port" prefWidth="70"/>
                    <TableColumn text="state" prefWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="choose a completed scan and press preview"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>
</BorderPane>
