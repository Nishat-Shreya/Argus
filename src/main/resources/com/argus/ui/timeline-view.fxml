<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.TimelineController"
            styleClass="timeline-root">
    <top>
        <VBox fx:id="root" styleClass="toolbar" spacing="10">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="timeline" styleClass="card-title"/>
                    <Label styleClass="card-subtitle" wrapText="true"
                           text="scrub a target's persisted scan history — each position shows what that scan recorded, never what changed between positions"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="target" styleClass="card-subtitle"/>
                    <ComboBox fx:id="targetCombo" prefWidth="220"/>
                </VBox>
                <Button fx:id="loadButton" text="load" styleClass="primary-button"
                        onAction="#onLoad"/>
                <Button fx:id="backButton" text="back to dashboard" styleClass="secondary-button"
                        onAction="#onBack"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-error" visible="false" managed="false"
                   wrapText="true"/>
            <HBox spacing="10">
                <Label fx:id="hiddenLabel" styleClass="form-hint"/>
                <Label fx:id="truncationLabel" styleClass="form-hint"/>
            </HBox>
            <VBox spacing="4">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="targetLabel" styleClass="card-subtitle"/>
                    <Label fx:id="positionLabel" styleClass="timeline-position"/>
                </HBox>
                <Slider fx:id="timelineSlider" styleClass="timeline-slider" min="0" max="0"
                        majorTickUnit="1" minorTickCount="0" showTickMarks="true"
                        showTickLabels="false" snapToTicks="true" blockIncrement="1"
                        disable="true"/>
            </VBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="findingsTable" styleClass="timeline-table">
            <columns>
                <TableColumn text="type" prefWidth="90"/>
                <TableColumn text="subject" prefWidth="220"/>
                <TableColumn text="port" prefWidth="70"/>
                <TableColumn text="state" prefWidth="90"/>
            </columns>
            <placeholder>
                <Label text="select a target and press load to see its scan history"/>
            </placeholder>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16"/>
            </padding>
            <Label fx:id="summaryLabel" styleClass="status-line"/>
        </HBox>
    </bottom>
</BorderPane>
